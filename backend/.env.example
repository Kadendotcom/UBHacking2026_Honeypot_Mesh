# Copy to .env and fill in.  .env is gitignored — never commit it.
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # for COLLECTOR_TOKEN

# SQLite file. Under data/, which is gitignored (holds real attacker IPs).
HONEYPOT_DB=./data/honeypot.db

# Keep this on loopback. The collector is not what we expose at the demo.
API_HOST=127.0.0.1
API_PORT=8000

# Shared secret the honeypots send as the X-Collector-Token header on POST /events.
# Must match what Person 1 puts in the honeypot config.
COLLECTOR_TOKEN=changeme

# Person 3's classifier. Leave blank to skip ML — sessions stay unclassified.
ML_URL=http://127.0.0.1:8100/classify

# Seconds of silence before a session is auto-closed by the reaper.
SESSION_IDLE_TIMEOUT=300
